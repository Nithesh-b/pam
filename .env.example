# WhatsApp Cloud API Configuration
# Get these from Meta Developer Console: https://developers.facebook.com/

# Your WhatsApp Business Account Access Token (permanent token recommended)
WHATSAPP_ACCESS_TOKEN=your_access_token_here

# Alias for WHATSAPP_ACCESS_TOKEN (some docs use this name)
WHATSAPP_TOKEN=your_access_token_here

# Phone Number ID from WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Verify token for webhook validation (you create this - any random string)
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# App Secret for webhook signature verification
WHATSAPP_APP_SECRET=your_app_secret_here

# Server Configuration
PORT=3000

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info
